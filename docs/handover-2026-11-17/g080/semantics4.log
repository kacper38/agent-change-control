== wrappers and shells in capitals
$ ENV true
-> exit 0
$ BASH -c echo ran-bash
ran-bash
-> exit 0
$ SH -c echo ran-sh
ran-sh
-> exit 0
$ ZSH -c echo ran-zsh
ran-zsh
-> exit 0
$ COMMAND echo ran-command
ran-command
-> exit 0
$ TIME true
        0.00 real         0.00 user         0.00 sys
-> exit 0
$ NOHUP true
-> exit 0
$ NICE true
-> exit 0
$ FIND . -maxdepth 0
.
-> exit 0
$ XARGS echo ran-xargs
-> exit 0
$ TIMEOUT 1 true
-> exit 0
$ EXEC true
<SCRATCH>/g080/semantics4.sh: line 10: EXEC: command not found
-> exit 127
$ EVAL true
<SCRATCH>/g080/semantics4.sh: line 10: EVAL: command not found
-> exit 127
$ NOGLOB true
<SCRATCH>/g080/semantics4.sh: line 10: NOGLOB: command not found
-> exit 127

