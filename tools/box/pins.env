# The box's pins, in one file (plan step 1.0a). tools/box/box.py passes every line as a --build-arg; the
# Dockerfile gives no defaults, so a missing pin fails the build. Bases by digest, tools by version, gh also by
# its release checksum. A Debian point release that drops a pinned package version fails the build until the
# pin is moved: that is on purpose. Read on 2026-11-20.
NODE_IMAGE=node:24-trixie-slim@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0
UV_IMAGE=ghcr.io/astral-sh/uv:0.11.26@sha256:3d868e555f8f1dbc324afa005066cd11e1053fc4743b9808ca8025283e65efa5
NODE_VERSION=24.22.3
APT_PINS=git=1:2.47.3-0+deb13u1 iptables=1.8.11-2 ipset=7.22-1+b1 curl=8.14.1-2+deb13u7 ca-certificates=20250419+deb13u1
PYTHON_39=3.9.25
PYTHON_313=3.13.13
PYTEST_39=8.4.2
PYTEST_313=9.2.0
RUFF=0.17.3
GH=2.92.0
GH_SHA256_ARM64=c2248526dd0160c08d3fccca2332c3c1a07c15a78b23978e77735f1b5a18cfee
GH_SHA256_AMD64=b57848131bdf0c229cd35e1f2a51aa718199858b2e728410b37e89a428943ec4
CLAUDE_CODE=2.1.323
